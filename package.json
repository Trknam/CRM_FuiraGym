{
  "name": "gym-crm-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "protobufjs"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gym-crm/frontend --filter @gym-crm/backend dev",
    "dev:frontend": "pnpm --filter @gym-crm/frontend dev",
    "dev:backend": "pnpm --filter @gym-crm/backend dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "pnpm --filter @gym-crm/backend exec prisma generate",
    "db:seed": "pnpm --filter @gym-crm/backend db:seed",
    "cloudflare:build": "pnpm --filter @gym-crm/frontend cloudflare:build",
    "cloudflare:deploy": "pnpm --filter @gym-crm/frontend cloudflare:deploy"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
