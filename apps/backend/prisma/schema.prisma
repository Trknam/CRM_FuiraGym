generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  BRANCH_MANAGER
  STAFF
}

enum AccountApprovalStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PackageStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  PAID
  PENDING
  CANCELLED
}

enum CheckInMethod {
  QR_CODE
  FRONT_DESK
}

enum CheckInStatus {
  VALID
  REJECTED
}

enum LeadStatus {
  NEW
  POTENTIAL
  CONVERTED
  UNQUALIFIED
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  fullName     String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  approvalStatus AccountApprovalStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  userBranches   UserBranch[]
  createdLeads   Lead[]          @relation("LeadCreatedBy")
  updatedLeads   Lead[]          @relation("LeadUpdatedBy")
  crmActivities  CrmActivity[]
  workoutPlans   WorkoutPlan[]
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@index([role])
  @@index([isActive])
  @@index([approvalStatus])
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBranches  UserBranch[]
  members       Member[]
  packages      GymPackage[]
  leads         Lead[]
  checkIns      CheckIn[]
  payments      Payment[]
  crmActivities CrmActivity[]
  settings      GymSetting[]
  trainers      Trainer[]
  workoutPlans  WorkoutPlan[]
  auditLogs     AuditLog[]

  @@index([isActive])
}

model UserBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Member {
  id          String       @id @default(cuid())
  branchId    String
  memberCode  String       @unique
  qrCode      String       @unique @default(cuid())
  fullName    String
  phone       String
  email       String?
  dateOfBirth DateTime?
  address     String?
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lastInactivityReminderSentAt DateTime?

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  memberships   Membership[]
  payments      Payment[]
  checkIns      CheckIn[]
  crmActivities CrmActivity[]
  workoutPlans  WorkoutPlan[]

  @@index([branchId])
  @@index([status])
  @@index([joinedAt])
  @@index([phone])
}

model GymPackage {
  id           String        @id @default(cuid())
  branchId     String
  code         String
  name         String
  durationDays Int
  price        Decimal       @db.Decimal(12, 2)
  description  String?
  status       PackageStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([status])
}

model Membership {
  id        String           @id @default(cuid())
  memberId  String
  packageId String
  startDate DateTime
  endDate   DateTime
  price     Decimal          @db.Decimal(12, 2)
  status    MembershipStatus @default(ACTIVE)
  note      String?
  renewalReminderSentAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  member   Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  package  GymPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([memberId])
  @@index([packageId])
  @@index([startDate, endDate])
  @@index([status])
  @@index([endDate, renewalReminderSentAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  branchId    String?
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  targetName  String?
  details     String?
  createdAt   DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([branchId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  entity    String?
  entityId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  branchId     String
  memberId     String
  membershipId String?
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  status       PaymentStatus @default(PAID)
  paidAt       DateTime?
  expiresAt    DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([memberId])
  @@index([status, paidAt])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model CheckIn {
  id          String        @id @default(cuid())
  branchId    String
  memberId    String
  checkedInAt DateTime
  method      CheckInMethod
  status      CheckInStatus @default(VALID)
  createdAt   DateTime      @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([branchId, checkedInAt])
  @@index([memberId, checkedInAt])
  @@index([status])
}

model Lead {
  id             String     @id @default(cuid())
  branchId       String
  fullName       String
  phone          String
  email          String?
  source         String?
  status         LeadStatus @default(NEW)
  nextFollowUpAt DateTime?
  note           String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy     User?         @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?         @relation("LeadUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  crmActivities CrmActivity[]

  @@index([branchId])
  @@index([status])
  @@index([nextFollowUpAt])
}

model Trainer {
  id         String   @id @default(cuid())
  branchId   String
  fullName   String
  email      String?
  phone      String
  specialty  String?
  bio        String?
  hourlyRate Decimal? @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([isActive])
  @@index([specialty])
}

enum CrmActivityType {
  CALL
  MESSAGE
  CONSULTATION
  FOLLOW_UP
  APPOINTMENT
  NOTE
}

enum CrmActivityStatus {
  PENDING
  DONE
}

model CrmActivity {
  id          String            @id @default(cuid())
  branchId    String
  memberId    String?
  leadId      String?
  createdById String?
  type        CrmActivityType
  note        String?
  status      CrmActivityStatus @default(PENDING)
  scheduledAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member    Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([memberId])
  @@index([leadId])
  @@index([scheduledAt])
}

model Exercise {
  id               String             @id @default(cuid())
  name             String
  muscle           String
  equipment        String?
  level            String
  description      String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  workoutExercises WorkoutExercise[]
  embedding        ExerciseEmbedding?

  @@index([muscle])
  @@index([level])
  @@index([isActive])
}

model GymSetting {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  value     String
  group     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, name])
  @@index([branchId, group])
}

model WorkoutPlan {
  id              String   @id @default(cuid())
  branchId        String
  memberId        String
  createdById     String?
  goal            String
  level           String
  sessionsPerWeek Int
  durationMinutes Int
  equipment       String
  preferences     String?
  notes           String?
  aiModel         String
  aiResponseId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  days      WorkoutDay[]

  @@index([branchId, createdAt])
  @@index([memberId, createdAt])
}

model WorkoutDay {
  id            String   @id @default(cuid())
  workoutPlanId String
  dayNumber     Int
  dayName       String
  title         String
  focus         String
  createdAt     DateTime @default(now())

  workoutPlan WorkoutPlan       @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]

  @@index([workoutPlanId, dayNumber])
}

model WorkoutExercise {
  id              String   @id @default(cuid())
  workoutDayId    String
  exerciseId      String
  sortOrder       Int
  sets            Int?
  reps            Int?
  durationMinutes Int?
  restSeconds     Int?
  note            String?
  createdAt       DateTime @default(now())

  workoutDay WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutDayId, sortOrder])
  @@index([exerciseId])
}

model ExerciseEmbedding {
  id          String                      @id @default(cuid())
  exerciseId  String                      @unique
  model       String
  contentHash String
  embedding   Unsupported("vector(1024)")
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([model])
}
