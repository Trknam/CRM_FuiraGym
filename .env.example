# Backend khi chạy trực tiếp trên Windows
DATABASE_URL="postgresql://gymcrm:gymcrm_password@localhost:5432/gymcrm?schema=public"
VALKEY_URL="redis://localhost:6379"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Frontend Docker dùng URL nội bộ này; khi chạy local có thể dùng http://localhost:4000
BACKEND_INTERNAL_URL="http://localhost:4000"
# Production Cloudflare build: public API origin, for example https://api.fuiragym.site
BACKEND_PUBLIC_URL="https://api.fuiragym.site"

# Tài khoản quản trị khởi tạo
INITIAL_ADMIN_EMAIL="admin@gymcrm.local"
INITIAL_ADMIN_PASSWORD="Admin@123456"
INITIAL_ADMIN_NAME="Quản trị hệ thống"

# Chi nhánh khởi tạo
INITIAL_BRANCH_CODE="CN001"
INITIAL_BRANCH_NAME="Chi nhánh chính"

# AI Workout - Ollama Cloud
WORKOUT_AI_PROVIDER="ollama-cloud"
WORKOUT_AI_MODEL="gpt-oss:120b"
OLLAMA_HOST="https://ollama.com"
OLLAMA_API_KEY="your_ollama_api_key"

# Vector Search - embedding cục bộ, planner vẫn chạy Ollama Cloud
WORKOUT_EMBEDDING_HOST="http://workout-embeddings:11434"
WORKOUT_EMBEDDING_MODEL="embeddinggemma:300m-qat-q4_0"
WORKOUT_EMBEDDING_DIMENSIONS="768"
